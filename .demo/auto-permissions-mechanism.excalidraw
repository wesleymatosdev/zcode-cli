    { "type": "text", "id": "t_n3", "x": 150, "y": 910, "width": 900, "height": 20, "text": "safety: classification only runs where a prompt would have shown — it can never widen yolo or override runtime denies", "fontSize": 16, "fontFamily": 1, "strokeColor": "#495057", "originalText": "safety: classification only runs where a prompt would have shown — it can never widen yolo or override runtime denies", "autoResize": true }
